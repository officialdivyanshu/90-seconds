# Copy this file to .env and fill in real values.
# .env is gitignored. This template is not — keep it free of real keys.

# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call /api/* (e.g. your Netlify
# URL). Unset or "*" allows any origin — fine for an API with no cookies/auth.
ALLOWED_ORIGINS=*

# ---- Gemini ----
# Get a key at https://aistudio.google.com/apikey
# New keys start with "AQ." (auth keys). Older "AIza" keys also work.
# Server-side only. Never expose this to the browser.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash-lite
# Gap between model calls in ms. 2200 ~= 27 req/min, under the free tier cap.
GEMINI_MIN_GAP_MS=2200

# ---- Session timings (seconds) ----
THINK_SECONDS=30
RECORD_SECONDS=90

# ---- Uploads ----
# The client uploads audio only (~1MB for a 90s take) — video stays in the
# browser. 40MB leaves headroom for the video/* fallback path without being
# sized for routine video uploads like the old default was.
MAX_UPLOAD_MB=40
UPLOAD_DIR=./uploads

# ---- Groq (transcription) ----
# Get a key at https://console.groq.com
GROQ_API_KEY=

# ---- Rate limiting ----
MAX_FEEDBACK_PER_IP_PER_DAY=20
